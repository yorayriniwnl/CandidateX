{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "apps/web",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "api": {
      "entrypoint": "services/backend/app.py",
      "routePrefix": "/backend",
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": {
      "chatgpt/*": false
    }
  }
}
