{
  "name": "candidate-capability-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Candidate Capability Intelligence (CCI) Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:backend": "python -m uvicorn cci.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir services/backend",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "resolutions": {
    "postcss": "^8.5.23"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
