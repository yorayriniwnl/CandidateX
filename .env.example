# Candidate Capability Intelligence (CCI) Environment Configuration

# Application
APP_NAME=Candidate Capability Intelligence
APP_ENV=development
DEBUG=false
API_PORT=8000
API_HOST=0.0.0.0
SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (Postgres / SQLite)
# For Postgres: postgresql+psycopg2://postgres:postgres@localhost:5432/cci_db
# For SQLite test/dev: sqlite:///./local_dev.db
DATABASE_URL=sqlite:///./local_dev.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Local Docker Compose only. Set a unique URL-safe password before starting the stack.
POSTGRES_USER=cci
POSTGRES_PASSWORD=
POSTGRES_DB=cci_platform

# Redis Cache & Broker Configuration
REDIS_URL=redis://localhost:6379/0

# Worker Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & Network Analysis Limits
MAX_REPOSITORY_SIZE_MB=500
MAX_REPOSITORY_PATHS=100000
MAX_FILE_SIZE_MB=5
ANALYSIS_TIMEOUT_SECONDS=300

# Scoring Constants & Defaults (Versioned ScoringConfig v1)
SCORING_CONFIG_VERSION=1.0.0
DEFAULT_TEMPERATURE=1.0
LOW_COVERAGE_THRESHOLD=0.35
CONTRADICTION_EPSILON=1e-5
PROBE_ALPHA=0.4
PROBE_BETA=0.35
PROBE_GAMMA=0.25

# Optional Integrations
GITHUB_TOKEN=
